# Скопіюйте цей файл у .env (він у .gitignore і не потрапить у репозиторій) і заповніть.
# Не публікуйте ключ ніде: ні в чаті, ні в скріншотах, ні в репозиторії.
LLM_API_KEY=
# Назву моделі покаже команда: python -m labcheck doctor (з ключем, але без LLM_MODEL друкує доступні)
LLM_MODEL=

# Типово використовується OpenAI-сумісний ендпойнт Gemini. Для іншого сервісу розкоментуйте й змініть:
# LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
# приклади інших сервісів: https://openrouter.ai/api/v1 , https://api.groq.com/openai/v1 , http://localhost:11434/v1 (Ollama)

# Ціна за 1 млн токенів у USD для рядка «вартість прогону» у звіті. Для безкоштовного рівня залиште 0.
LLM_PRICE_IN_PER_M=0
LLM_PRICE_OUT_PER_M=0

# Якщо сервіс підтримує режим JSON (response_format), можна ввімкнути: LLM_JSON_MODE=1

# Скільки разів повторювати запит при HTTP 429/5xx («модель перевантажена»); між повторами пауза 2→45 с. Типово 6.
# LLM_RETRIES=6
